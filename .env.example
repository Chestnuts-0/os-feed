# ════════════════════════════════════════════════════════════════
# 开源版抖音信息流 — 环境变量示例
# 复制为 .env（本地开发）或配置 GitHub Secrets（线上 Actions）
# ════════════════════════════════════════════════════════════════

# ── LLM Provider ─────────────────────────────────────────────────
# 默认用智谱（GLM-4.7-Flash 永久免费、OpenAI 兼容）
# 可选: zhipu | deepseek | openai | anthropic | openrouter | github-copilot | agnes
LLM_PROVIDER=zhipu

# ── 智谱 AI (https://open.bigmodel.cn 获取 key，免费档) ──────────
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL=glm-4.7-flash

# ── 备选 provider（按 LLM_PROVIDER 切换时启用）──────────────────
# AGNES_API_KEY=your_agnes_api_key_here
# AGNES_MODEL=agnes-2.0-flash
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# ── GitHub ───────────────────────────────────────────────────────
# GitHub Actions 运行时会自动注入 GITHUB_TOKEN；本地运行需自备 PAT
GITHUB_TOKEN=your_github_personal_access_token

# 写入 Issue 的目标仓库（格式: 用户名/仓库名）
DIGEST_REPO=your-username/os-feed

# 关注名单自动同步账号（TA 的 GitHub 关注列表并入大牛名单）
# FOLLOWING_USER=Chestnuts-Sisyphus

# ── 推送渠道（可选，按需开启）──────────────────────────────────
# 飞书自定义机器人 webhook（多个用逗号分隔）
FEISHU_WEBHOOK_URLS=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Product Hunt（可选数据源）
PRODUCTHUNT_TOKEN=

# ── 关注大牛清单（逗号分隔的 GitHub 用户名）──────────────────────
# 留空则用 config.yml 里的默认；也可在 config.yml 配置
BIGBROS=
