# ════════════════════════════════════════════════════════════════
# 开源版抖音信息流 — 环境变量示例
# 复制为 .env（本地开发）或配置 GitHub Secrets（线上 Actions）
# ════════════════════════════════════════════════════════════════

# ── LLM Provider ─────────────────────────────────────────────────
# 默认用智谱（GLM-4.7-Flash 永久免费、OpenAI 兼容）
# 可选: zhipu | deepseek | openai | anthropic | openrouter | github-copilot |
#       agnes | groq | gemini | cerebras | siliconflow | github-models | mistral
LLM_PROVIDER=zhipu

# ── 免费编队并行池（LLM_FALLBACKS=逗号分隔名单）─────────────────
# 名单里同一项写几遍=该源开几个串行 worker；`源@模型` 覆盖模型；多 key 轮转：
# {NAME}_API_KEY 逗号分隔多 key，同名条目按序取号（Groq/Gemini/HF 多账号=真乘法）。
# `custom:名` 泛化通道：配 {NAME}_API_KEY/{NAME}_BASE_URL/{NAME}_MODEL 三个变量即入池
# （BASE_URL 有 SSRF 校验：仅 http/https，拒 localhost/私网/保留地址）。
# 示例（≈32 worker）：
# LLM_FALLBACKS=agnes,agnes,zhipu,zhipu,groq,groq,groq,groq,groq,groq,groq@openai/gpt-oss-20b,groq@openai/gpt-oss-20b,groq@qwen/qwen3.8-27b,groq@qwen/qwen3.8-27b,gemini,gemini,gemini,gemini@gemini-2.5-flash-lite,gemini@gemini-2.5-flash-lite,siliconflow,siliconflow,siliconflow,siliconflow@THUDM/glm-4-9b-chat,siliconflow@THUDM/glm-4-9b-chat,siliconflow@THUDM/glm-4-9b-chat,mistral,mistral,mistral,mistral,hf@meta-llama/Llama-3.3-70B-Instruct,hf@Qwen/Qwen2.5-72B-Instruct,openrouter@google/gemma-4-31b-it:free

# Groq（console.groq.com，免费档 30 RPM/模型，同 key 多模型配额叠加）
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Gemini（aistudio.google.com，免费档；flash/flash-lite 分开计）
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# SiliconFlow（siliconflow.cn，免费模型各有限速）
# SILICONFLOW_API_KEY=

# GitHub Models（已退役 410 Gone，源移除；provider 类留档）
# GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

# HuggingFace（router.huggingface.co，免费月度 credits 持续发放，量级 $0.10/月小量补位）
# HF_API_KEY=
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# 泛化通道（LLM_FALLBACKS 写 custom:名，三个变量即入池，零代码加免费源）
# 例：LLM_FALLBACKS=custom:myfreer …
# MYFREER_API_KEY=
# MYFREER_BASE_URL=https://api.example.com/v1
# MYFREER_MODEL= some-free-model

# Mistral（console.mistral.ai 免费层，1 RPS）
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# ── 智谱 AI (https://open.bigmodel.cn 获取 key，免费档) ──────────
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL=glm-4.7-flash

# ── 备选 provider（按 LLM_PROVIDER 切换时启用）──────────────────
# AGNES_API_KEY=your_agnes_api_key_here
# AGNES_MODEL=agnes-2.0-flash
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# ── GitHub ───────────────────────────────────────────────────────
# GitHub Actions 运行时会自动注入 GITHUB_TOKEN；本地运行需自备 PAT
GITHUB_TOKEN=your_github_personal_access_token

# 写入 Issue 的目标仓库（格式: 用户名/仓库名）
DIGEST_REPO=your-username/gittok

# ── 推送渠道（可选，按需开启）──────────────────────────────────
# 飞书自定义机器人 webhook（多个用逗号分隔）
FEISHU_WEBHOOK_URLS=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Product Hunt（可选数据源）
PRODUCTHUNT_TOKEN=

# ── 关注（2026-09-01 关注解耦）────────────────────────────────
# 旧的 FOLLOWING_USER / BIGBROS 名单抓取已退役：现在关注频道的大牛背书
# 由管道「库内 star 盖章」自动产生（对库内 User owner 拉最近 star，
# 只给库里已有 repo 加标签，不新建卡），无需任何环境变量。
