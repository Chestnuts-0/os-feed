# ════════════════════════════════════════════════════════════════
# 开源版抖音信息流 — 环境变量示例
# 复制为 .env（本地开发）或配置 GitHub Secrets（线上 Actions）
# ════════════════════════════════════════════════════════════════

# ── LLM Provider ─────────────────────────────────────────────────
# 默认用智谱（GLM-4.7-Flash 永久免费、OpenAI 兼容）
# 可选: zhipu | deepseek | openai | anthropic | openrouter | github-copilot |
#       agnes | groq | gemini | cerebras | siliconflow | github-models | mistral
LLM_PROVIDER=zhipu

# ── 免费编队并行池（LLM_FALLBACKS=逗号分隔源名单）───────────────
# 主源 + 名单内备源组成 worker 池 round-robin 分摊（吞吐 ≈ N×单源），
# 429 拉满自动冷却 5 分钟、key 缺失自动跳过——配几个 key 就并行几个源。
# 本地：LLM_FALLBACKS=github-models,groq,gemini,siliconflow,mistral
# 线上：同名单配到 GitHub Secrets（.github/workflows/daily-digest.yml）
# LLM_FALLBACKS=agnes,groq,gemini,siliconflow,github-models,mistral

# Groq（console.groq.com，免费档 30 RPM）
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Gemini（aistudio.google.com，免费档）
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# SiliconFlow（siliconflow.cn，免费档）
# SILICONFLOW_API_KEY=

# GitHub Models（用现成 GITHUB_TOKEN 即可调用，免费层 ≈15 RPM/150 RPD）
# GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

# Mistral（console.mistral.ai 免费层，1 RPS）
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# ── 智谱 AI (https://open.bigmodel.cn 获取 key，免费档) ──────────
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL=glm-4.7-flash

# ── 备选 provider（按 LLM_PROVIDER 切换时启用）──────────────────
# AGNES_API_KEY=your_agnes_api_key_here
# AGNES_MODEL=agnes-2.0-flash
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# ── GitHub ───────────────────────────────────────────────────────
# GitHub Actions 运行时会自动注入 GITHUB_TOKEN；本地运行需自备 PAT
GITHUB_TOKEN=your_github_personal_access_token

# 写入 Issue 的目标仓库（格式: 用户名/仓库名）
DIGEST_REPO=your-username/gittok

# ── 推送渠道（可选，按需开启）──────────────────────────────────
# 飞书自定义机器人 webhook（多个用逗号分隔）
FEISHU_WEBHOOK_URLS=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Product Hunt（可选数据源）
PRODUCTHUNT_TOKEN=

# ── 关注（2026-09-01 关注解耦）────────────────────────────────
# 旧的 FOLLOWING_USER / BIGBROS 名单抓取已退役：现在关注频道的大牛背书
# 由管道「库内 star 盖章」自动产生（对库内 User owner 拉最近 star，
# 只给库里已有 repo 加标签，不新建卡），无需任何环境变量。
